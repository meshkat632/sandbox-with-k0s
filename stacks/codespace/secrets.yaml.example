# Template for secrets.yaml. Not encrypted - do not put real secrets here.
#
#   cp secrets.yaml.example secrets.yaml
#   (edit the values, then)  make encrypt
#
# `make encrypt` encrypts the password values with sops + age
# (recipients are set in the repo's .sops.yaml).
db:
  username: admin
  password: change-me

ssh_keys:
  - name: me
    email: you@example.com
    type: ed25519
    # ~/.ssh/codespace_ed25519.pub
    public_key: ssh-ed25519 AAAA... you@example.com
