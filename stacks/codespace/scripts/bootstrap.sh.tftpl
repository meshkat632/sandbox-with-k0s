#!/bin/bash
# Bootstrap script for ${name}
# Installed at /opt/codespace/bootstrap.sh and run once by cloud-init on first boot.
# Safe to re-run by hand: sudo /opt/codespace/bootstrap.sh
set -euo pipefail
exec > >(tee -a /var/log/codespace-bootstrap.log) 2>&1
trap 'echo "ERROR: bootstrap failed at line $LINENO: $BASH_COMMAND" >&2' ERR

echo "=== bootstrap start: $(date -Is) ==="

export DEBIAN_FRONTEND=noninteractive
DEV_USER="ubuntu"
HOME_DIR="/home/$DEV_USER"

# On first boot unattended-upgrades often holds the dpkg lock; wait for it
# instead of failing, and retry flaky mirror downloads.
APT_OPTS=(-q -o DPkg::Lock::Timeout=600 -o Acquire::Retries=5)

# --- 1. Base packages --------------------------------------------------------
apt-get "$${APT_OPTS[@]}" update
apt-get "$${APT_OPTS[@]}" install -y \
  git curl wget unzip jq htop tmux make \
  python3 python3-venv python3-pip python3-dev python3-boto3 python3-yaml build-essential

# --- 2. Python virtualenv for the dev user ----------------------------------
if [ ! -d "$HOME_DIR/.venvs/dev" ]; then
  sudo -u "$DEV_USER" -H python3 -m venv "$HOME_DIR/.venvs/dev"
fi
sudo -u "$DEV_USER" -H "$HOME_DIR/.venvs/dev/bin/pip" install -q --upgrade pip
%{ if length(python_packages) > 0 ~}
sudo -u "$DEV_USER" -H "$HOME_DIR/.venvs/dev/bin/pip" install -q %{ for p in python_packages ~}'${p}' %{ endfor }
%{ endif ~}

grep -q ".venvs/dev/bin/activate" "$HOME_DIR/.bashrc" ||
  echo "source $HOME_DIR/.venvs/dev/bin/activate" >> "$HOME_DIR/.bashrc"

# --- 3. Workspace ------------------------------------------------------------
sudo -u "$DEV_USER" mkdir -p "$HOME_DIR/workspace"

echo "=== bootstrap done: $(date -Is) ==="
