# Copy to .env and edit:  cp .env.example .env
# The Makefile sources this file before every terraform / aws command.
# .env is gitignored - never commit real values.

# --- AWS ---------------------------------------------------------------------
# Named profile from ~/.aws/credentials or ~/.aws/config (aws configure --profile ...).
# Needs rights for EC2, IAM, Secrets Manager and SSM.
export AWS_PROFILE=default

# Region is set by var.region (default eu-central-1). If you change it, also
# pass it to the Makefile:  make kubeconfig REGION=us-east-1
# export TF_VAR_region=eu-central-1

# --- Network -----------------------------------------------------------------
# Who may reach SSH (22) and the Kubernetes API (6443). JSON list of CIDRs.
# Use your own public IP:  echo "[\"$(curl -s https://checkip.amazonaws.com)/32\"]"
export TF_VAR_allowed_cidrs='["203.0.113.10/32"]'

# --- SOPS (decrypts secrets.yaml) --------------------------------------------
# Path to your age private key. This is sops' default location, so you can
# leave it commented out if you keep the key there.
# export SOPS_AGE_KEY_FILE=$HOME/.config/sops/age/keys.txt
