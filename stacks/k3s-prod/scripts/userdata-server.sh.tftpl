#!/bin/bash
# No -x: this script handles the cluster token, and its output goes to the EC2 console log.
set -euo pipefail

# Basic hardening for a lightweight node
echo "net.ipv4.ip_forward=1" >> /etc/sysctl.d/99-k3s.conf
echo "net.bridge.bridge-nf-call-iptables=1" >> /etc/sysctl.d/99-k3s.conf
sysctl --system

# --- K3s configuration ----------------------------------------------------------
umask 077
mkdir -p /etc/rancher/k3s /etc/rancher/node

# Fixed node password (K3s would otherwise generate a random one). A cluster restored
# from a snapshot still holds the old password for this node name, and would reject a
# rebuilt node that comes up with a new one.
printf '%s' '${node_password}' > /etc/rancher/node/password

cat > /etc/rancher/k3s/config.yaml <<'EOF'
token: "${k3s_token}"
cluster-cidr: "${cluster_cidr}"
service-cidr: "${service_cidr}"
node-name: "${node_name}"
write-kubeconfig-mode: "600"
disable:
  - servicelb
  - traefik
%{ if is_first ~}
cluster-init: true
%{ else ~}
server: "https://${server0_ip}:6443"
%{ endif ~}
EOF
umask 022

# --- Install ----------------------------------------------------------------------
%{ if is_first && restore_snapshot != "" ~}
# Restore etcd from S3 before the first start. The token above must be the one the
# snapshot was taken with.
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" INSTALL_K3S_SKIP_START=true sh -s - server
k3s server --cluster-reset \
  --cluster-reset-restore-path="${restore_snapshot}" \
  --etcd-s3 \
  --etcd-s3-bucket="${etcd_s3_bucket}" \
  --etcd-s3-region="${etcd_s3_region}" \
  --etcd-s3-folder="${etcd_s3_folder}"
systemctl start k3s
%{ else ~}
%{ if !is_first ~}
until curl -ksf https://${server0_ip}:6443/ping; do sleep 5; done

%{ endif ~}
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server
%{ endif ~}
